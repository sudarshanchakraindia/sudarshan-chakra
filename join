<script>
function shareApp() {
  const shareData = {
    title: 'Sudarshan Chakra India 🇮🇳',
    text: '🙏 भारत का अपना सर्विस ऐप — Sudarshan Chakra India\n\n✅ कोई ब्रोकर नहीं · कोई बिचौलिया नहीं\n✅ जुड़ना जीवनभर मुफ़्त — कारीगर और ग्राहक दोनों के लिए\n✅ 500+ सेवाएँ · 12 भाषाएँ\n\nNo broker. No middleman. Lifetime free to join.',
    url: location.href
  };
  if (navigator.share) {
    navigator.share(shareData).catch(() => {});
  } else {
    const text = shareData.text + '\n\n' + shareData.url;
    (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject()).then(() => {
      alert('✅ Link copy हो गया! WhatsApp या कहीं भी paste करके share करें।\nLink copied — paste it anywhere to share.');
    }).catch(() => {
      prompt('यह संदेश copy करके share करें · Copy and share:', text);
    });
  }
}

// Animate elements on scroll
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.style.opacity = '1';
      e.target.style.transform = 'translateY(0)';
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('.feature-card, .step, .vision-card, .wallet-card, .lang-chip, .audience-card').forEach(el => {
  el.style.opacity = '0';
  el.style.transform = 'translateY(24px)';
  el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
  observer.observe(el);
});

// Keep a partner/referrer code (?ref=...) when sending visitors to the app,
// so the app can still credit the person who shared this page.
(function () {
  const ref = new URLSearchParams(location.search).get('ref');
  if (!ref) return;
  document.querySelectorAll('a.app-link').forEach(a => {
    const u = new URL(a.href);
    u.searchParams.set('ref', ref);
    a.href = u.toString();
  });
})();
</script>

