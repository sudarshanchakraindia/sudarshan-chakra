<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sudarshan Chakra India — भारत का अपना सर्विस ऐप</title>
<meta name="description" content="Hyperlocal service app for India. No broker, no middleman, lifetime free to join for service providers and seekers. 500+ services in 12 Indian languages.">
<meta property="og:title" content="Sudarshan Chakra India 🇮🇳 — भारत का अपना सर्विस ऐप">
<meta property="og:description" content="कोई ब्रोकर नहीं · कोई बिचौलिया नहीं · जुड़ना जीवनभर मुफ़्त — No broker, no middleman, lifetime free to join">
<meta property="og:url" content="https://sudarshanchakraindia.github.io/sudarshan-chakra/join.html">
<meta property="og:image" content="https://sudarshanchakraindia.github.io/sudarshan-chakra/icon-512.png">
<link rel="icon" href="icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600&family=Baloo+2:wght@600;700;800&family=Mukta:wght@400;600&display=swap" rel="stylesheet">

<style>
  :root {
    --saffron: #FF6B00;
    --deep-saffron: #E55200;
    --gold: #F5A623;
    --cream: #FFF8F0;
    --deep: #1A1206;
    --mid: #4A2C0A;
    --soft: #7C4A1E;
    --white: #FFFFFF;
    --green: #138808;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--deep);
    overflow-x: hidden;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    background: linear-gradient(135deg, #1A0A00 0%, #3D1A00 40%, #1A0A00 100%);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px 80px;
    overflow: hidden;
    text-align: center;
  }

  /* Mandala background */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 20%, rgba(255,107,0,0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(245,166,35,0.12) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(255,107,0,0.05) 0%, transparent 70%);
    pointer-events: none;
  }
  /* Chakra watermark behind hero content */
  .hero::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 600px; height: 600px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(255,107,0,0.10) 0%, rgba(150,100,255,0.06) 60%, transparent 80%);
    opacity: 1;
    pointer-events: none;
    animation: spin 80s linear infinite;
  }

  .mandala-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255,107,0,0.12);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation: spin 40s linear infinite;
  }
  .mandala-ring:nth-child(1) { width: 800px; height: 800px; animation-duration: 60s; }
  .mandala-ring:nth-child(2) { width: 600px; height: 600px; animation-duration: 45s; animation-direction: reverse; border-style: dashed; border-color: rgba(245,166,35,0.10); }
  .mandala-ring:nth-child(3) { width: 400px; height: 400px; animation-duration: 30s; border-color: rgba(255,107,0,0.15); }

  @keyframes spin { to { transform: translate(-50%,-50%) rotate(360deg); } }

  .hero-logo-img {
    margin-bottom: 20px;
    position: relative; z-index: 1;
    animation: popIn 0.9s cubic-bezier(.34,1.56,.64,1) 0.1s both;
  }
  .hero-logo-img img {
    animation: floatChakra 4s ease-in-out infinite;
  }
  @keyframes floatChakra {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(3deg); }
  }

  @keyframes popIn {
    from { opacity:0; transform: scale(0.5) translateY(20px); }
    to   { opacity:1; transform: scale(1) translateY(0); }
  }

  .hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px; font-weight: 600;
    letter-spacing: 3px; text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
    position: relative; z-index: 1;
    animation: fadeUp 0.7s ease 0.4s both;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(38px, 8vw, 72px);
    font-weight: 900;
    color: white;
    line-height: 1.08;
    margin-bottom: 12px;
    position: relative; z-index: 1;
    animation: fadeUp 0.7s ease 0.5s both;
  }

  .hero-title span {
    background: linear-gradient(90deg, var(--saffron), var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-hindi {
    font-family: 'Baloo 2', cursive;
    font-size: clamp(20px, 4vw, 32px);
    color: rgba(255,255,255,0.7);
    margin-bottom: 28px;
    position: relative; z-index: 1;
    animation: fadeUp 0.7s ease 0.6s both;
  }

  .hero-tagline {
    font-size: clamp(15px, 2.5vw, 20px);
    color: rgba(255,255,255,0.85);
    max-width: 520px;
    line-height: 1.6;
    margin-bottom: 48px;
    position: relative; z-index: 1;
    font-weight: 300;
    animation: fadeUp 0.7s ease 0.7s both;
  }

  .hero-tagline strong { color: var(--gold); font-weight: 600; }

  .hero-cta-group {
    display: flex; flex-wrap: wrap; gap: 14px;
    justify-content: center;
    position: relative; z-index: 1;
    animation: fadeUp 0.7s ease 0.9s both;
  }

  .btn-primary {
    display: inline-flex; align-items: center; gap: 10px;
    background: linear-gradient(135deg, var(--saffron), var(--gold));
    color: white; font-weight: 700; font-size: 15px;
    padding: 16px 32px; border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 8px 30px rgba(255,107,0,0.4);
    transition: transform 0.2s, box-shadow 0.2s;
    border: none; cursor: pointer;
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(255,107,0,0.5); }

  .btn-secondary {
    display: inline-flex; align-items: center; gap: 10px;
    background: rgba(255,255,255,0.1);
    color: white; font-weight: 600; font-size: 15px;
    padding: 16px 32px; border-radius: 50px;
    text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.25);
    transition: background 0.2s, border-color 0.2s;
    backdrop-filter: blur(10px);
  }
  .btn-secondary:hover { background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.4); }

  /* scroll indicator */
  .scroll-hint {
    position: absolute; bottom: 28px; left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    color: rgba(255,255,255,0.35); font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
    z-index: 1; animation: bounce 2s ease-in-out infinite 2s;
  }
  .scroll-hint .arrow { font-size: 18px; }
  @keyframes bounce { 0%,100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(6px); } }

  @keyframes fadeUp {
    from { opacity:0; transform: translateY(24px); }
    to   { opacity:1; transform: translateY(0); }
  }

  /* ── STATS STRIP ── */
  .stats-strip {
    background: linear-gradient(135deg, var(--saffron), var(--deep-saffron));
    padding: 28px 20px;
  }
  .stats-inner {
    max-width: 960px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 0; text-align: center;
  }
  .stat-item { padding: 8px 16px; }
  .stat-item + .stat-item { border-left: 1px solid rgba(255,255,255,0.3); }
  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: clamp(24px, 4vw, 36px); font-weight: 900;
    color: white; display: block;
  }
  .stat-label { font-size: 12px; color: rgba(255,255,255,0.85); font-weight: 500; margin-top: 2px; }

  /* ── SECTION COMMON ── */
  section { padding: 80px 20px; }
  .section-inner { max-width: 960px; margin: 0 auto; }
  .section-label {
    font-size: 11px; font-weight: 700; letter-spacing: 3px;
    text-transform: uppercase; color: var(--saffron);
    margin-bottom: 12px;
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 5vw, 44px); font-weight: 700;
    line-height: 1.2; margin-bottom: 16px; color: var(--deep);
  }
  .section-sub {
    font-size: 17px; color: var(--soft); line-height: 1.7;
    max-width: 560px; margin-bottom: 48px; font-weight: 300;
  }

  /* ── FEATURES ── */
  .features-bg { background: white; }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .feature-card {
    background: var(--cream);
    border-radius: 20px; padding: 28px 24px;
    border: 1px solid rgba(255,107,0,0.1);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    position: relative; overflow: hidden;
  }
  .feature-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--saffron), var(--gold));
    opacity: 0; transition: opacity 0.2s;
  }
  .feature-card:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(255,107,0,0.12); border-color: rgba(255,107,0,0.25); }
  .feature-card:hover::before { opacity: 1; }
  .feature-icon { font-size: 32px; margin-bottom: 14px; display: block; }
  .feature-title { font-weight: 700; font-size: 15px; color: var(--deep); margin-bottom: 8px; }
  .feature-desc { font-size: 13px; color: var(--soft); line-height: 1.65; font-weight: 300; }

  /* ── LANGUAGES ── */
  .languages-bg { background: linear-gradient(135deg, #FFF8F0, #FEF3E2); }
  .lang-grid {
    display: flex; flex-wrap: wrap; gap: 10px;
    margin-top: 32px;
  }
  .lang-chip {
    display: flex; align-items: center; gap: 8px;
    background: white; border: 1.5px solid rgba(255,107,0,0.15);
    border-radius: 50px; padding: 10px 18px;
    font-size: 14px; font-weight: 500; color: var(--mid);
    transition: all 0.2s; cursor: default;
  }
  .lang-chip:hover { background: var(--saffron); color: white; border-color: var(--saffron); transform: scale(1.03); }
  .lang-chip .script { font-size: 16px; }

  /* ── HOW IT WORKS ── */
  .steps { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 24px; }
  .step {
    text-align: center; padding: 32px 20px;
    background: white; border-radius: 24px;
    border: 1px solid rgba(255,107,0,0.08);
    position: relative;
  }
  .step-num {
    width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(135deg, var(--saffron), var(--gold));
    color: white; font-family: 'Playfair Display', serif;
    font-size: 18px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
    box-shadow: 0 4px 16px rgba(255,107,0,0.3);
  }
  .step-icon { font-size: 28px; margin-bottom: 12px; display: block; }
  .step-title { font-weight: 700; font-size: 15px; color: var(--deep); margin-bottom: 8px; }
  .step-desc { font-size: 13px; color: var(--soft); line-height: 1.6; font-weight: 300; }

  /* ── VISION ── */
  .vision-bg {
    background: linear-gradient(135deg, #1A0A00 0%, #3D1A00 60%, #1A0A00 100%);
    position: relative; overflow: hidden;
  }
  .vision-bg .section-title { color: white; }
  .vision-bg .section-sub { color: rgba(255,255,255,0.7); }
  .vision-bg .section-label { color: var(--gold); }
  .vision-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px; margin-top: 8px;
  }
  .vision-card {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,107,0,0.2);
    border-radius: 20px; padding: 28px 22px;
    backdrop-filter: blur(10px);
    transition: background 0.2s, border-color 0.2s;
  }
  .vision-card:hover { background: rgba(255,107,0,0.12); border-color: rgba(255,107,0,0.4); }
  .vision-card .icon { font-size: 28px; margin-bottom: 14px; display: block; }
  .vision-card h4 { font-weight: 700; font-size: 15px; color: white; margin-bottom: 8px; }
  .vision-card p { font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.65; font-weight: 300; }

  /* light-background variant, used on cream sections */
  .vision-card.on-light {
    background: white;
    border: 1px solid rgba(122,74,30,0.15);
    box-shadow: 0 4px 20px rgba(122,74,30,0.06);
  }
  .vision-card.on-light:hover { background: rgba(255,107,0,0.06); border-color: rgba(255,107,0,0.3); }
  .vision-card.on-light h4 { color: var(--deep); }
  .vision-card.on-light p { color: var(--soft); }

  /* ── FLOATING "BECOME A PARTNER" BUTTON (bottom-left) ── */
  .partner-fab {
    position: fixed;
    left: 20px;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    z-index: 900; /* below the partner modal (999) */
    padding: 14px 22px;
    font-size: 15px;
    box-shadow: 0 8px 28px rgba(255,107,0,0.45);
    animation: partnerBlink 1.6s ease-in-out infinite;
  }
  .partner-fab:hover { animation-play-state: paused; }
  @keyframes partnerBlink {
    0%, 100% { opacity: 1; transform: scale(1);    box-shadow: 0 8px 28px rgba(255,107,0,0.45), 0 0 0 0 rgba(255,107,0,0.55); }
    50%      { opacity: 0.55; transform: scale(1.06); box-shadow: 0 8px 28px rgba(255,107,0,0.45), 0 0 0 14px rgba(255,107,0,0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .partner-fab { animation: none; }
  }
  @media (max-width: 520px) {
    .partner-fab { left: 14px; bottom: calc(14px + env(safe-area-inset-bottom, 0px)); padding: 12px 18px; font-size: 14px; }
  }

  /* ── PARTNER APPLICATION MODAL ── */
  .partner-modal-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(26,18,6,0.72);
    backdrop-filter: blur(4px);
    z-index: 999;
    align-items: flex-start;
    justify-content: center;
    padding: 40px 16px;
    overflow-y: auto;
  }
  .partner-modal-overlay.open { display: flex; }
  .partner-modal {
    background: var(--white);
    border-radius: 24px;
    max-width: 560px;
    width: 100%;
    padding: 36px 30px;
    position: relative;
    box-shadow: 0 30px 80px rgba(0,0,0,0.35);
    animation: popIn 0.3s ease both;
  }
  .partner-modal-close {
    position: absolute; top: 18px; right: 18px;
    width: 34px; height: 34px; border-radius: 50%;
    border: none; background: rgba(122,74,30,0.08);
    color: var(--soft); font-size: 22px; line-height: 1;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .partner-modal-close:hover { background: rgba(255,107,0,0.15); color: var(--deep-saffron); }
  .pf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pf-field { margin-bottom: 16px; }
  .pf-field label {
    display: block; font-size: 13px; font-weight: 600;
    color: var(--deep); margin-bottom: 6px;
  }
  .pf-field label span { color: var(--soft); font-weight: 400; }
  .pf-field input, .pf-field textarea {
    width: 100%; padding: 11px 14px;
    border: 1px solid rgba(122,74,30,0.2);
    border-radius: 12px;
    font-family: inherit; font-size: 14px;
    color: var(--deep);
    background: var(--cream);
    transition: border-color 0.2s;
  }
  .pf-field input:focus, .pf-field textarea:focus {
    outline: none; border-color: var(--saffron);
    background: white;
  }
  .pf-field textarea { resize: vertical; min-height: 100px; }
  @media (max-width: 520px) {
    .pf-row { grid-template-columns: 1fr; }
  }

  /* ── WALLET & CHARITY ── */
  .wallet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 8px; }
  .wallet-card {
    border-radius: 24px; padding: 32px 28px; color: white;
    position: relative; overflow: hidden;
  }
  .wallet-card.orange { background: linear-gradient(135deg, var(--saffron), #FF9500); }
  .wallet-card.green  { background: linear-gradient(135deg, #138808, #22c55e); }
  .wallet-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px; font-weight: 700; margin-bottom: 12px;
  }
  .wallet-card p { font-size: 14px; line-height: 1.65; opacity: 0.9; font-weight: 300; }
  .wallet-card .wc-icon { font-size: 48px; position: absolute; bottom: 20px; right: 20px; opacity: 0.25; }

  /* ── TESTIMONIAL-STYLE QUOTE ── */
  .quote-section { background: white; }
  .quote-box {
    max-width: 700px; margin: 0 auto; text-align: center;
    padding: 48px 32px;
    background: linear-gradient(135deg, #FFF8F0, #FEF3E2);
    border-radius: 32px;
    border: 1.5px solid rgba(255,107,0,0.15);
    position: relative;
  }
  .quote-mark {
    font-family: 'Playfair Display', serif;
    font-size: 120px; line-height: 0.6;
    color: rgba(255,107,0,0.12); position: absolute;
    top: 24px; left: 32px; pointer-events: none;
  }
  .quote-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(18px, 3vw, 26px); font-style: italic;
    color: var(--deep); line-height: 1.55; margin-bottom: 24px;
    position: relative; z-index: 1;
  }
  .quote-author { font-size: 13px; font-weight: 600; color: var(--saffron); letter-spacing: 1px; text-transform: uppercase; }

  /* ── CTA SECTION ── */
  .cta-section {
    background: linear-gradient(135deg, var(--saffron) 0%, var(--gold) 100%);
    text-align: center; padding: 80px 20px;
    position: relative; overflow: hidden;
  }
  .cta-section::before {
    content: '';
    position: absolute;
    right: -80px; bottom: -80px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(255,107,0,0.15) 0%, rgba(150,100,255,0.08) 60%, transparent 80%);
    opacity: 1;
    pointer-events: none;
    animation: spin 60s linear infinite;
  }
  .cta-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 5vw, 48px); font-weight: 900;
    color: white; margin-bottom: 16px; line-height: 1.2;
  }
  .cta-section p { font-size: 17px; color: rgba(255,255,255,0.88); margin-bottom: 40px; font-weight: 300; }
  .cta-btn-group { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
  .cta-btn-white {
    display: inline-flex; align-items: center; gap: 10px;
    background: white; color: var(--saffron);
    font-weight: 700; font-size: 16px;
    padding: 18px 36px; border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 8px 32px rgba(0,0,0,0.15);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .cta-btn-white:hover { transform: translateY(-2px); box-shadow: 0 12px 44px rgba(0,0,0,0.2); }
  .cta-btn-outline {
    display: inline-flex; align-items: center; gap: 10px;
    background: transparent; color: white;
    font-weight: 600; font-size: 16px;
    padding: 18px 36px; border-radius: 50px;
    text-decoration: none;
    border: 2px solid rgba(255,255,255,0.5);
    transition: background 0.2s;
  }
  .cta-btn-outline:hover { background: rgba(255,255,255,0.15); }

  /* ── FOOTER ── */
  footer {
    background: var(--deep); color: rgba(255,255,255,0.6);
    text-align: center; padding: 40px 20px;
    font-size: 13px;
  }
  footer strong { color: var(--gold); }
  footer .flag { font-size: 20px; vertical-align: middle; }

  /* ── TRICOLOR STRIPE ── */
  .tricolor {
    height: 5px;
    background: linear-gradient(90deg, #FF9933 33.3%, white 33.3% 66.6%, #138808 66.6%);
  }

  /* Share button */
  .share-fab {
    position: fixed; bottom: 24px; right: 24px;
    background: linear-gradient(135deg, var(--saffron), var(--gold));
    color: white; border: none; border-radius: 50px;
    padding: 14px 22px; font-size: 14px; font-weight: 700;
    cursor: pointer; box-shadow: 0 8px 32px rgba(255,107,0,0.45);
    display: flex; align-items: center; gap: 8px;
    z-index: 100; transition: transform 0.2s;
  }
  .share-fab:hover { transform: scale(1.05); }

  @media (max-width: 600px) {
    .stats-inner { grid-template-columns: repeat(2, 1fr); }
    .stat-item:nth-child(3) { border-left: none; border-top: 1px solid rgba(255,255,255,0.3); }
    .stat-item:nth-child(4) { border-top: 1px solid rgba(255,255,255,0.3); }
    .wallet-grid { grid-template-columns: 1fr; }
  }

  /* ── BILINGUAL ADDITIONS ── */
  body { font-family: 'DM Sans', 'Mukta', sans-serif; }
  .hi { font-family: 'Baloo 2', 'Mukta', sans-serif; }
