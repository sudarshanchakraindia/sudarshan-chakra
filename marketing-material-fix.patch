-  // falls back quietly to sharing the link.
+  // Sharing the actual file is what partners want — WhatsApp then attaches the
+  // poster or reel itself instead of a long storage link that most recipients
+  // never tap. The file has to be fetched first, and a cross-origin fetch of a
+  // Firebase Storage object only succeeds once CORS is enabled on the bucket
+  // (cors.json in the repo). Everything below degrades in order:
+  //   file share  →  text share  →  wa.me link
+  function materialFileName(m){
+    if (m && m.fileName) return m.fileName;
+    const raw = String((m && m.url) || '').split('?')[0].split('/').pop() || '';
+    try { return decodeURIComponent(raw) || 'material'; } catch (e) { return raw || 'material'; }
+  }
+
+  // The promo text that travels with the poster. A partner's own referral link
+  // is worth far more to the recipient than the storage URL of the image.
+  function materialShareText(m){
+    const ref = window._currentRefLink;
+    const out = [m.name || 'Sudarshan Chakra India'];
+    if (m.desc) out.push(m.desc);
+    out.push(ref ? 'रजिस्टर करें / Register: ' + ref : (m.url || ''));
+    return out.filter(Boolean).join('\n');
+  }
+
+  async function fetchFileFromUrl(url, fileName){
+    if (!url || !/^https?:/i.test(url)) return null;
+    if (/\.html?$/.test(matPath(url))) return null;   // a reel page, not a file
+    try {
+      const res = await fetch(url, { mode: 'cors', cache: 'no-store' });
+      if (!res.ok) return null;
+      const blob = await res.blob();
+      return new File([blob], fileName || 'material', { type: blob.type || 'application/octet-stream' });
+    } catch (e) {
+      // Nearly always a missing CORS rule on the storage bucket — logged, not
+      // shown, because the link fallback still gets the job done.
+      console.warn('File share unavailable (CORS?), falling back to link:', e && e.message);
+      return null;
+    }
+  }
+
