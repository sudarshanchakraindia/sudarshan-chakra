{
              "rules": {

                "providers": {
                                  ".read": true,
                                  "$providerId": {
                                                      ".write": "auth != null && (!data.exists() || root.child('providers').child($providerId).child('ownerUid').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
                                                      "reviews": {
                                                                            ".write": "auth != null"
                                                      },
                                                      "earnings": {
                                                                            ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
                                                      },
                                                      "totalEarnings": {
                                                                            ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
                                                      },
                                                      "profileViews": {
                                                                            ".write": "auth != null"
                                                      },
                                                      "bookings": {
                                                                            ".write": "auth != null"
                                                      }
                                  }
                },

                "reviews": {
                                  ".read": true,
                                  "$providerId": {
                                                      "$reviewId": {
                                                                            ".write": "auth != null"
                                                      }
                                  }
                },

                              "users": {
                                                "$uid": {
                                                                    ".read": "auth != null && auth.uid === $uid",
                                                                    ".write": "auth != null && auth.uid === $uid"
                                                }
                              },

                              "bookings": {
                                                ".read": "auth != null",
                                                "$bookingId": {
                                                                    ".write": "auth != null"
                                                }
                              },

                              "chats": {
                                                ".read": "auth != null",
                                                "$roomId": {
                                                                    ".write": "auth != null"
                                                }
                              },

                              "seekers": {
                                                "$uid": {
                                                                    ".read": "auth != null && auth.uid === $uid",
                                                                    ".write": "auth != null && auth.uid === $uid"
                                                }
                              },

                              "categories": {
                                                ".read": true,
                                                ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
                              },

                              "admins": {
                                                ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
                                                ".write": false
                              },

                              "admin": {
                                                ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
                                                ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
                              }

              }
}
